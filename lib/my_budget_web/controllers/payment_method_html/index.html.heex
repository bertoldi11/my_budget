<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header>
    Métodos de Pagamento
    <:subtitle>Como você paga suas movimentações.</:subtitle>
    <:actions>
      <.button variant="primary" href={~p"/payment_method/new"}>
        <.icon name="hero-plus" /> Novo
      </.button>
    </:actions>
  </.header>

  <%!-- Estado vazio --%>
  <div
    :if={@payment_method_collection == []}
    class="rounded-box border border-dashed border-base-300 py-12 text-center"
  >
    <.icon name="hero-credit-card" class="mx-auto size-10 text-base-content/40" />
    <p class="mt-2 font-medium">Nenhum método de pagamento cadastrado</p>
    <p class="text-sm text-base-content/60">
      Cadastre métodos de pagamento para usar nas movimentações.
    </p>
    <.button variant="primary" href={~p"/payment_method/new"} class="mt-4">
      <.icon name="hero-plus" /> Novo método
    </.button>
  </div>

  <%!-- Lista --%>
  <section
    :if={@payment_method_collection != []}
    class="rounded-box border border-base-300 bg-base-100 overflow-hidden"
  >
    <ul class="divide-y divide-base-200">
      <li
        :for={payment_method <- @payment_method_collection}
        id={"payment_method-#{payment_method.id}"}
        class="group flex items-center justify-between gap-3 px-4 py-3 hover:bg-base-200/50"
      >
        <.link
          href={~p"/payment_method/#{payment_method}"}
          class="flex-1 font-medium hover:underline"
        >
          {payment_method.name}
        </.link>

        <div class="flex items-center gap-3 text-sm">
          <.link
            href={~p"/payment_method/#{payment_method}/edit"}
            class="inline-flex items-center gap-1 text-base-content/70 hover:text-primary"
          >
            <.icon name="hero-pencil-square" class="size-4" /> Editar
          </.link>
          <.link
            href={~p"/payment_method/#{payment_method}"}
            method="delete"
            data-confirm="Tem certeza que quer apagar esse método de pagamento?"
            class="inline-flex items-center gap-1 text-base-content/70 hover:text-error"
          >
            <.icon name="hero-trash" class="size-4" /> Apagar
          </.link>
        </div>
      </li>
    </ul>
  </section>
</Layouts.app>
