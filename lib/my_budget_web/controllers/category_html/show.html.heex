<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header>
    Categoria {@category.id}
    <:actions>
      <.button href={~p"/category"} class="btn btn-ghost">
        <.icon name="hero-arrow-left" />
      </.button>
      <.button variant="primary" href={~p"/category/#{@category}/edit?return_to=show"}>
        <.icon name="hero-pencil-square" /> Editar
      </.button>
    </:actions>
  </.header>

  <div class="rounded-box border border-base-300 bg-base-100 p-2">
    <.list>
      <:item title="Nome">{@category.name}</:item>
    </.list>
  </div>
</Layouts.app>
