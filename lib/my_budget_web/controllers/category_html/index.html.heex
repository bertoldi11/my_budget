<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header>
    Categorias
    <:subtitle>Suas categorias organizadas por sessão.</:subtitle>
    <:actions>
      <.button variant="primary" href={~p"/category/new"}>
        <.icon name="hero-plus" /> Nova
      </.button>
    </:actions>
  </.header>

  <%!-- Estado vazio --%>
  <div
    :if={@active_groups == [] and @inactive_groups == []}
    class="rounded-box border border-dashed border-base-300 py-12 text-center"
  >
    <.icon name="hero-tag" class="mx-auto size-10 text-base-content/40" />
    <p class="mt-2 font-medium">Nenhuma categoria cadastrada</p>
    <p class="text-sm text-base-content/60">
      Cadastre categorias para organizar suas movimentações.
    </p>
    <.button variant="primary" href={~p"/category/new"} class="mt-4">
      <.icon name="hero-plus" /> Nova categoria
    </.button>
  </div>

  <div :if={@active_groups != [] or @inactive_groups != []} class="space-y-8">
    <.category_groups
      id="active-categories"
      title="Ativas"
      groups={@active_groups}
      category_ids_with_movements={@category_ids_with_movements}
      empty_message="Nenhuma categoria ativa."
    />

    <.category_groups
      :if={@inactive_groups != []}
      id="inactive-categories"
      title="Inativas"
      groups={@inactive_groups}
      category_ids_with_movements={@category_ids_with_movements}
      muted
    />
  </div>
</Layouts.app>
