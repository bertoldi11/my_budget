<div class="rounded-box border border-base-300 bg-base-100 p-6">
  <.form for={@form} id="category-form" action={@action} class="space-y-4">
    <input type="hidden" name="return_to" value={@return_to} />
    <.input field={@form[:name]} type="text" label="Nome" />
    <.input field={@form[:section_id]} type="select" label="Sessão" options={@sections_options} />
    <%= if @show_budget_toggle do %>
      <.input field={@form[:budget_active]} type="checkbox" label="Ativo no orçamento" />
    <% end %>
    <footer class="mt-6 flex items-center gap-3">
      <.button phx-disable-with="Processando..." variant="primary">Salvar</.button>
      <.button href={@cancel_path} class="btn btn-ghost">Cancelar</.button>
    </footer>
  </.form>
</div>
