<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header>
    {@page_title}
  </.header>

  <.category_form
    form={@form}
    action={~p"/category/#{@category}"}
    sections_options={@sections_options}
    return_to={@return_to}
    cancel_path={if(@return_to == "show", do: ~p"/category/#{@category}", else: ~p"/category")}
  />
</Layouts.app>
