<div class="rounded-box border border-base-300 bg-base-100 p-6">
  <.form for={@form} id="movement-form" action={@action} class="space-y-4">
    <input type="hidden" name="return_to" value={@return_to} />
    <.input
      field={@form[:category_id]}
      type="select"
      label="Categoria"
      prompt="Selecione uma categoria"
      options={@categories_options}
      data-combobox="true"
    />
    <.input
      field={@form[:payment_method_id]}
      type="select"
      label="Pago com"
      options={@payment_method_options}
    />
    <.input field={@form[:expend_date]} type="date" label="Data" />
    <.input field={@form[:type]} type="select" label="Tipo" options={@type_options} />
    <.input
      field={@form[:amount_reais]}
      type="text"
      label="Valor (R$)"
      placeholder="0,00"
      autocomplete="off"
      data-currency-mask="true"
    />
    <.input field={@form[:description]} type="text" label="Descrição" />
    <.input field={@form[:counter_party]} type="text" label="Pago a/Recebido de" />
    <footer class="mt-6 flex items-center gap-3">
      <.button phx-disable-with="Processando..." variant="primary">Salvar</.button>
      <.button href={@cancel_path} class="btn btn-ghost">Cancelar</.button>
    </footer>
  </.form>
</div>
