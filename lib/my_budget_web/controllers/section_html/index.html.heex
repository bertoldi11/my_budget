<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header>
    Sessões
    <:subtitle>Agrupam suas categorias.</:subtitle>
    <:actions>
      <.button variant="primary" href={~p"/section/new"}>
        <.icon name="hero-plus" /> Nova
      </.button>
    </:actions>
  </.header>

  <%!-- Estado vazio --%>
  <div
    :if={@active_sections == [] and @inactive_sections == []}
    class="rounded-box border border-dashed border-base-300 py-12 text-center"
  >
    <.icon name="hero-folder" class="mx-auto size-10 text-base-content/40" />
    <p class="mt-2 font-medium">Nenhuma sessão cadastrada</p>
    <p class="text-sm text-base-content/60">
      Cadastre sessões para agrupar suas categorias.
    </p>
    <.button variant="primary" href={~p"/section/new"} class="mt-4">
      <.icon name="hero-plus" /> Nova sessão
    </.button>
  </div>

  <div :if={@active_sections != [] or @inactive_sections != []} class="space-y-8">
    <.section_group
      id="active-sections"
      title="Ativas"
      sections={@active_sections}
      section_ids_with_categories={@section_ids_with_categories}
      empty_message="Nenhuma sessão ativa."
    />

    <.section_group
      :if={@inactive_sections != []}
      id="inactive-sections"
      title="Inativas"
      sections={@inactive_sections}
      section_ids_with_categories={@section_ids_with_categories}
      muted
    />
  </div>
</Layouts.app>
