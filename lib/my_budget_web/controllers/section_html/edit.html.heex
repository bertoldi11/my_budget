<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header>
    {@page_title}
  </.header>

  <.section_form
    form={@form}
    action={~p"/section/#{@section}"}
    return_to={@return_to}
    cancel_path={if(@return_to == "show", do: ~p"/section/#{@section}", else: ~p"/section")}
  />
</Layouts.app>
