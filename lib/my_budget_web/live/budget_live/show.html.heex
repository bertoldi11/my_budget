<Layouts.app flash={@flash} current_scope={@current_scope}>
  <%!-- Header --%>
  <div class="flex items-center justify-between gap-3">
    <.header>
      {@page_title}
      <:subtitle>
        <span class={[
          "badge badge-sm",
          @budget.status == "balanced" && "badge-success",
          @budget.status != "balanced" && "badge-ghost"
        ]}>
          {if @budget.status == "balanced", do: "Equilibrado", else: "Rascunho"}
        </span>
      </:subtitle>
    </.header>
    <div class="flex gap-2 shrink-0">
      <.button id="copy-prev-month" phx-click="copy_previous_month" class="btn btn-ghost btn-sm">
        <.icon name="hero-document-duplicate" class="size-4" /> Copiar mês anterior
      </.button>
      <.link navigate={~p"/budget"} class="btn btn-ghost btn-sm">
        <.icon name="hero-arrow-left" class="size-4" />
      </.link>
    </div>
  </div>

  <%!-- Rollover dialog --%>
  <%= if @show_rollover_dialog do %>
    <div
      id="rollover-dialog"
      class="rounded-box border border-warning bg-warning/10 p-5 space-y-4"
    >
      <div class="flex items-start gap-2">
        <.icon name="hero-arrow-path" class="size-5 text-warning mt-0.5 shrink-0" />
        <div>
          <p class="font-semibold text-sm">Saldo do mês anterior disponível</p>
          <p class="text-sm text-base-content/70 mt-1">
            Algumas categorias do mês anterior estão inativas. Selecione uma categoria ativa de destino para cada saldo.
          </p>
        </div>
      </div>
      <div class="space-y-3">
        <%= for rollover <- @pending_rollovers do %>
          <div id={"rollover-#{rollover.category_id}"} class="flex items-center gap-3 text-sm">
            <span class="font-medium min-w-[12rem]">
              {rollover.category.name}
              <span class="text-success ml-1">R$ {format_reais(rollover.surplus)}</span>
            </span>
            <span class="text-base-content/50">→</span>
            <select
              id={"rollover-select-#{rollover.category_id}"}
              class="select select-bordered select-sm flex-1"
              phx-change="rollover_redirect"
              name="to_category"
              data-from={rollover.category_id}
            >
              <option value="">Selecione...</option>
              <%= for section <- @sections do %>
                <optgroup label={section.name}>
                  <%= for cat <- section.categories do %>
                    <option value={cat.id}>{cat.name}</option>
                  <% end %>
                </optgroup>
              <% end %>
            </select>
          </div>
        <% end %>
      </div>
      <div class="flex gap-2">
        <.button id="apply-rollovers" variant="primary" phx-click="apply_rollovers">
          Aplicar Saldos
        </.button>
        <.button id="dismiss-rollover" phx-click="dismiss_rollover" class="btn btn-ghost">
          Pular por agora
        </.button>
      </div>
    </div>
  <% end %>

  <%!-- Resumo financeiro --%>
  <div id="budget-summary" class="grid grid-cols-3 gap-3">
    <div class="rounded-box border border-base-300 bg-base-100 p-4 text-center">
      <p class="text-xs text-base-content/60 uppercase tracking-wide">Receitas</p>
      <p class="text-xl font-bold text-success mt-1">R$ {format_reais(@total_income)}</p>
    </div>
    <div class="rounded-box border border-base-300 bg-base-100 p-4 text-center">
      <p class="text-xs text-base-content/60 uppercase tracking-wide">Alocado</p>
      <p class="text-xl font-bold mt-1">R$ {format_reais(@total_allocated)}</p>
    </div>
    <div class="rounded-box border border-base-300 bg-base-100 p-4 text-center">
      <p class="text-xs text-base-content/60 uppercase tracking-wide">Restante</p>
      <p class={["text-xl font-bold mt-1", remaining_class(@remaining)]}>
        R$ {format_reais(@remaining)}
      </p>
    </div>
  </div>

  <%!-- Receitas --%>
  <section id="incomes-section" class="space-y-3">
    <div class="flex items-center justify-between">
      <h2 class="font-semibold text-sm uppercase tracking-wide text-base-content/60">Receitas</h2>
      <.button id="add-income" phx-click="new_income" class="btn btn-ghost btn-xs">
        <.icon name="hero-plus" class="size-3" /> Adicionar
      </.button>
    </div>

    <%!-- Formulário de receita --%>
    <%= if @editing_income_id do %>
      <div id="income-form" class="rounded-box border border-base-300 bg-base-100 p-4">
        <.form
          for={@income_form}
          id="budget-income-form"
          phx-submit="save_income"
          phx-change="validate_income"
          class="flex gap-3 items-end"
        >
          <div class="flex-1">
            <.input
              field={@income_form[:description]}
              type="text"
              label="Descrição"
              placeholder="Ex: Salário"
            />
          </div>
          <div class="w-40">
            <.input
              field={@income_form[:amount_reais]}
              type="text"
              label="Valor (R$)"
              placeholder="0,00"
              data-currency-mask
            />
          </div>
          <div class="flex gap-2 pb-1">
            <.button id="save-income-btn" type="submit" variant="primary">Salvar</.button>
            <.button
              id="cancel-income-btn"
              type="button"
              phx-click="cancel_income"
              class="btn btn-ghost"
            >
              Cancelar
            </.button>
          </div>
        </.form>
      </div>
    <% end %>

    <%!-- Lista de receitas --%>
    <div
      :if={@incomes == [] and is_nil(@editing_income_id)}
      class="rounded-box border border-dashed border-base-300 py-6 text-center text-sm text-base-content/50"
    >
      Nenhuma receita cadastrada ainda.
    </div>

    <ul
      :if={@incomes != []}
      class="rounded-box border border-base-300 bg-base-100 overflow-hidden divide-y divide-base-200"
    >
      <li
        :for={income <- @incomes}
        id={"income-#{income.id}"}
        class="flex items-center justify-between px-4 py-3 gap-3"
      >
        <span class="flex-1">{income.description}</span>
        <span class="font-medium text-success">R$ {format_reais(income.amount)}</span>
        <div class="flex gap-2 text-sm">
          <button
            id={"edit-income-#{income.id}"}
            phx-click="edit_income"
            phx-value-id={income.id}
            class="text-base-content/60 hover:text-primary"
          >
            <.icon name="hero-pencil-square" class="size-4" />
          </button>
          <button
            id={"delete-income-#{income.id}"}
            phx-click="delete_income"
            phx-value-id={income.id}
            data-confirm="Remover esta receita?"
            class="text-base-content/60 hover:text-error"
          >
            <.icon name="hero-trash" class="size-4" />
          </button>
        </div>
      </li>
    </ul>
  </section>

  <%!-- Alocações por seção/categoria --%>
  <section id="allocations-section" class="space-y-4">
    <h2 class="font-semibold text-sm uppercase tracking-wide text-base-content/60">Alocações</h2>

    <div
      :if={@sections == []}
      class="rounded-box border border-dashed border-base-300 py-8 text-center text-sm text-base-content/50"
    >
      Nenhuma seção ativa para o orçamento. Ative seções e categorias no cadastro.
    </div>

    <%= for section <- @sections do %>
      <div
        id={"section-#{section.id}"}
        class="rounded-box border border-base-300 bg-base-100 overflow-hidden"
      >
        <div class="bg-base-200/60 px-4 py-2">
          <h3 class="font-semibold text-sm">{section.name}</h3>
        </div>

        <%!-- Header da tabela --%>
        <div class="grid grid-cols-[1fr_8rem_8rem_8rem] gap-2 px-4 py-2 text-xs text-base-content/50 uppercase tracking-wide border-b border-base-200">
          <span>Categoria</span>
          <span class="text-right">Planejado</span>
          <span class="text-right">Gasto</span>
          <span class="text-right">Diferença</span>
        </div>

        <%= for category <- section.categories do %>
          <% allocation = Map.get(@allocation_map, category.id) %>
          <% planned =
            if(allocation, do: allocation.planned_amount + allocation.rollover_amount, else: 0) %>
          <% spent = Map.get(@spent_map, category.id, 0) %>
          <% diff = planned - spent %>
          <div
            id={"allocation-#{category.id}"}
            class="grid grid-cols-[1fr_8rem_8rem_8rem] gap-2 px-4 py-2.5 items-center border-b border-base-200 last:border-0 hover:bg-base-200/30"
          >
            <div class="text-sm flex items-center gap-1">
              {category.name}
              <%= if allocation && allocation.rollover_amount > 0 do %>
                <span
                  class="badge badge-xs badge-info"
                  title={"Rollover: R$ #{format_reais(allocation.rollover_amount)}"}
                >
                  +R$ {format_reais(allocation.rollover_amount)}
                </span>
              <% end %>
            </div>
            <div class="text-right">
              <input
                id={"allocation-input-#{category.id}"}
                type="text"
                class="input input-bordered input-sm w-full text-right"
                value={format_reais(if(allocation, do: allocation.planned_amount, else: 0))}
                data-currency-mask
                phx-blur="save_allocation"
                phx-value-category_id={category.id}
                name="amount"
              />
            </div>
            <div class="text-right text-sm font-medium">
              R$ {format_reais(spent)}
            </div>
            <div class={["text-right text-sm font-medium", diff_class(diff)]}>
              R$ {format_reais(diff)}
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>
</Layouts.app>
