<Layouts.app flash={@flash} current_scope={@current_scope}>
  <%!-- Navegação de mês --%>
  <div class="flex items-center justify-between gap-2">
    <.link
      id="previous-month"
      patch={~p"/?m=#{@previous_date.month}&y=#{@previous_date.year}"}
      class="btn btn-ghost btn-sm"
    >
      <.icon name="hero-arrow-left" />
      <span class="hidden sm:inline">{@previous_date.month_string}/{@previous_date.year}</span>
    </.link>

    <h1 class="text-center text-lg font-semibold capitalize">
      {@current_date.month_string}
      <span class="text-base-content/60">de {@current_date.year}</span>
    </h1>

    <.link
      id="next-month"
      patch={~p"/?m=#{@next_date.month}&y=#{@next_date.year}"}
      class="btn btn-ghost btn-sm"
    >
      <span class="hidden sm:inline">{@next_date.month_string}/{@next_date.year}</span>
      <.icon name="hero-arrow-right" />
    </.link>
  </div>

  <%!-- Total do mês --%>
  <div class="rounded-box bg-primary text-primary-content p-5 shadow-sm flex items-center justify-between gap-4">
    <div>
      <p class="text-sm opacity-80">Total movimentado</p>
      <p class="mt-1 text-3xl font-bold tabular-nums">{@grand_total}</p>
      <p class="mt-1 text-sm opacity-80">
        {@current_date.month_string} de {@current_date.year} · {length(@sections)} {if(
          length(@sections) == 1,
          do: "seção",
          else: "seções"
        )}
      </p>
    </div>
    <button
      id="new-movement-btn"
      phx-click="open_modal"
      class="btn btn-sm shrink-0 border border-primary-content/30 bg-transparent text-primary-content hover:bg-primary-content/15 transition-colors"
    >
      <.icon name="hero-plus" class="size-4" /> Nova
    </button>
  </div>

  <%!-- Estado vazio --%>
  <div
    :if={@sections == []}
    class="rounded-box border border-dashed border-base-300 py-12 text-center"
  >
    <.icon name="hero-banknotes" class="mx-auto size-10 text-base-content/40" />
    <p class="mt-2 font-medium">Nenhuma movimentação em {@current_date.month_string}</p>
    <p class="text-sm text-base-content/60">
      Cadastre movimentações para ver o resumo do mês aqui.
    </p>
    <.button variant="primary" phx-click="open_modal" class="mt-4">
      <.icon name="hero-plus" /> Nova movimentação
    </.button>
  </div>

  <%!-- Seções --%>
  <div class="space-y-4">
    <%= for section <- @sections do %>
      <section class="rounded-box border border-base-300 bg-base-100 overflow-hidden">
        <header class="flex items-center justify-between gap-3 bg-base-200 px-4 py-3">
          <div class="flex items-center gap-2">
            <h2 class="font-semibold">{section.section_name}</h2>
            <span class="badge badge-sm badge-ghost">{section.count}</span>
          </div>
          <span class="font-semibold tabular-nums">{section.total_amount}</span>
        </header>

        <ul class="divide-y divide-base-200">
          <%= for category <- section.categories do %>
            <li>
              <%!-- Cabeçalho do acordeon: abre/fecha a lista de movimentações --%>
              <button
                type="button"
                id={"category-toggle-#{category.id}"}
                phx-click="toggle_category"
                phx-value-id={category.id}
                aria-expanded={to_string(expanded?(@expanded_categories, category.id))}
                aria-controls={"category-movements-#{category.id}"}
                class="w-full cursor-pointer px-4 py-3 text-left transition-colors hover:bg-base-200/60"
              >
                <div class="flex items-center justify-between gap-3">
                  <span class="flex min-w-0 items-center gap-2">
                    <.icon
                      name="hero-chevron-right"
                      class={[
                        "size-4 shrink-0 text-base-content/50 transition-transform duration-200",
                        expanded?(@expanded_categories, category.id) && "rotate-90"
                      ]}
                    />
                    <span class="truncate">{category.category}</span>
                    <span class="badge badge-xs badge-ghost shrink-0">{category.count}</span>
                  </span>
                  <span class="font-medium tabular-nums">{category.formatted_amount}</span>
                </div>
                <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-base-300">
                  <div
                    class="h-full rounded-full bg-primary transition-all duration-300"
                    style={"width: #{bar_width(category.amount, section.total)}"}
                  >
                  </div>
                </div>
              </button>

              <%!-- Movimentações da categoria, da mais recente para a mais antiga --%>
              <div
                :if={expanded?(@expanded_categories, category.id)}
                id={"category-movements-#{category.id}"}
                role="region"
                aria-labelledby={"category-toggle-#{category.id}"}
                class="border-t border-base-200 bg-base-200/40 px-4"
              >
                <ul class="divide-y divide-base-300/60">
                  <li
                    :for={movement <- category.movements}
                    id={"movement-#{movement.id}"}
                    class="flex items-start justify-between gap-3 py-2.5"
                  >
                    <div class="min-w-0">
                      <p class="truncate text-sm font-medium">{movement.description}</p>
                      <p class="mt-0.5 flex flex-wrap items-center gap-x-1.5 text-xs text-base-content/60">
                        <span class="tabular-nums">{movement.formatted_expend_date}</span>
                        <span :if={movement.counter_party} aria-hidden="true">·</span>
                        <span :if={movement.counter_party} class="truncate">
                          {movement.counter_party}
                        </span>
                        <span :if={movement.payment_method} aria-hidden="true">·</span>
                        <span :if={movement.payment_method} class="truncate">
                          {movement.payment_method}
                        </span>
                      </p>
                    </div>
                    <span class={[
                      "shrink-0 text-sm font-medium tabular-nums",
                      if(movement.type == "credit", do: "text-success", else: "text-base-content")
                    ]}>
                      {movement.formatted_amount}
                    </span>
                  </li>
                </ul>
              </div>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>

  <%!-- Modal nova movimentação --%>
  <%= if @show_modal do %>
    <div
      id="movement-modal"
      class="fixed inset-0 z-50 flex items-center justify-center p-4"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modal-title"
    >
      <%!-- Backdrop --%>
      <div
        class="absolute inset-0 bg-black/50 backdrop-blur-sm"
        phx-click="close_modal"
      >
      </div>

      <%!-- Conteúdo --%>
      <div class="relative z-10 w-full max-w-md rounded-box bg-base-100 shadow-xl overflow-y-auto max-h-[90vh]">
        <div class="flex items-center justify-between border-b border-base-300 px-6 py-4">
          <h2 id="modal-title" class="text-lg font-semibold">Nova movimentação</h2>
          <button
            id="close-modal-btn"
            phx-click="close_modal"
            class="btn btn-ghost btn-sm btn-circle"
            aria-label="Fechar"
          >
            <.icon name="hero-x-mark" class="size-4" />
          </button>
        </div>

        <div class="p-6">
          <.form
            for={@form}
            id="modal-movement-form"
            phx-submit="save"
            phx-change="validate"
            class="space-y-4"
          >
            <%!-- Combobox de categoria com filtro client-side --%>
            <div class="fieldset mb-2">
              <label>
                <span class="label mb-1">Categoria</span>

                <%!-- Select real: oculto visualmente, acessível ao LiveViewTest e ao phx-change --%>
                <select
                  id={@form[:category_id].id}
                  name={@form[:category_id].name}
                  class="sr-only"
                  tabindex="-1"
                  aria-hidden="true"
                >
                  <option value="">Selecione uma categoria</option>
                  <%= for {label, value} <- @categories_options do %>
                    <option
                      value={value}
                      selected={to_string(@form[:category_id].value) == to_string(value)}
                    >
                      {label}
                    </option>
                  <% end %>
                </select>

                <%!-- UI da combobox: gerenciada pelo hook JS --%>
                <div
                  id="category-combobox"
                  phx-hook=".CategoryCombobox"
                  phx-update="ignore"
                  data-select-id={@form[:category_id].id}
                  class="relative"
                >
                  <div class="relative">
                    <input
                      type="text"
                      id="category-combobox-search"
                      placeholder="Buscar categoria..."
                      autocomplete="off"
                      class="w-full input pr-9"
                      role="combobox"
                      aria-autocomplete="list"
                      aria-controls="category-combobox-options"
                      aria-expanded="false"
                    />
                    <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center">
                      <.icon name="hero-chevron-up-down" class="size-4 text-base-content/50" />
                    </span>
                  </div>
                  <ul
                    id="category-combobox-options"
                    role="listbox"
                    class="absolute z-20 mt-1 hidden max-h-60 w-full overflow-auto rounded-box border border-base-300 bg-base-100 py-1 shadow-lg"
                  >
                    <li
                      data-no-match
                      class="hidden select-none px-3 py-2 text-sm text-base-content/50"
                    >
                      Nenhuma categoria encontrada
                    </li>
                    <%= for {label, value} <- @categories_options do %>
                      <li
                        role="option"
                        data-value={value}
                        data-label={label}
                        class="cursor-pointer select-none px-3 py-2 text-sm transition-colors hover:bg-primary/10 hover:text-primary"
                      >
                        {label}
                      </li>
                    <% end %>
                  </ul>
                </div>
              </label>
              <%= if Phoenix.Component.used_input?(@form[:category_id]) do %>
                <%= for error <- @form[:category_id].errors do %>
                  <p class="mt-1.5 flex gap-2 items-center text-sm text-error">
                    <.icon name="hero-exclamation-circle" class="size-5" />
                    {translate_error(error)}
                  </p>
                <% end %>
              <% end %>
            </div>
            <.input
              field={@form[:payment_method_id]}
              type="select"
              label="Pago com"
              options={@payment_method_options}
            />
            <.input field={@form[:expend_date]} type="date" label="Data" />
            <.input field={@form[:type]} type="select" label="Tipo" options={@type_options} />
            <.input
              field={@form[:amount_reais]}
              type="text"
              label="Valor (R$)"
              placeholder="0,00"
              autocomplete="off"
              data-currency-mask="true"
            />
            <.input field={@form[:description]} type="text" label="Descrição" />
            <.input field={@form[:counter_party]} type="text" label="Pago a/Recebido de" />

            <footer class="mt-6 flex items-center gap-3">
              <.button phx-disable-with="Salvando..." variant="primary">Salvar</.button>
              <.button type="button" phx-click="close_modal">Cancelar</.button>
            </footer>
          </.form>
        </div>
      </div>
    </div>
  <% end %>
</Layouts.app>

<script :type={Phoenix.LiveView.ColocatedHook} name=".CategoryCombobox">
  export default {
    mounted() {
      this.controller = new AbortController()
      const signal = this.controller.signal

      const selectId = this.el.dataset.selectId
      this.selectInput = document.getElementById(selectId)
      this.searchInput = this.el.querySelector("#category-combobox-search")
      this.optionsList = this.el.querySelector("#category-combobox-options")
      this.allOptions = Array.from(this.optionsList.querySelectorAll("li[data-value]"))
      this.noMatchMsg = this.optionsList.querySelector("[data-no-match]")
      this.highlighted = -1
      this.isOpen = false

      this.syncLabelFromValue()

      this.searchInput.addEventListener("input", (e) => this.onInput(e))
      this.searchInput.addEventListener("focus", () => this.openDropdown())
      this.searchInput.addEventListener("keydown", (e) => this.onKeydown(e))
      this.optionsList.addEventListener("mousedown", (e) => this.onOptionMousedown(e))
      document.addEventListener("click", (e) => this.onDocumentClick(e), {signal})
    },

    destroyed() {
      this.controller.abort()
    },

    syncLabelFromValue() {
      const value = this.selectInput.value
      if (!value) return
      const opt = this.allOptions.find(li => li.dataset.value == value)
      if (opt) this.searchInput.value = opt.dataset.label
    },

    openDropdown() {
      if (this.isOpen) return
      this.isOpen = true
      this.optionsList.classList.remove("hidden")
      this.searchInput.setAttribute("aria-expanded", "true")
      this.filterOptions(this.searchInput.value)
    },

    closeDropdown() {
      if (!this.isOpen) return
      this.isOpen = false
      this.optionsList.classList.add("hidden")
      this.searchInput.setAttribute("aria-expanded", "false")
      this.highlighted = -1
      this.clearHighlight()
      const value = this.selectInput.value
      if (value) {
        const opt = this.allOptions.find(li => li.dataset.value == value)
        if (opt) this.searchInput.value = opt.dataset.label
      } else {
        this.searchInput.value = ""
      }
    },

    onInput(e) {
      this.openDropdown()
      this.filterOptions(e.target.value)
      if (this.selectInput.value) {
        this.selectInput.value = ""
        this.selectInput.dispatchEvent(new Event("input", {bubbles: true}))
      }
    },

    filterOptions(query) {
      const q = (query || "").toLowerCase().trim()
      let visibleCount = 0
      this.allOptions.forEach(li => {
        const matches = !q || li.dataset.label.toLowerCase().includes(q)
        li.classList.toggle("hidden", !matches)
        if (matches) visibleCount++
      })
      this.noMatchMsg.classList.toggle("hidden", visibleCount > 0)
      this.highlighted = -1
      this.clearHighlight()
    },

    onOptionMousedown(e) {
      e.preventDefault()
      const li = e.target.closest("li[data-value]")
      if (li) this.selectOption(li)
    },

    selectOption(li) {
      this.searchInput.value = li.dataset.label
      this.selectInput.value = li.dataset.value
      this.selectInput.dispatchEvent(new Event("input", {bubbles: true}))
      this.selectInput.dispatchEvent(new Event("change", {bubbles: true}))
      this.closeDropdown()
    },

    onKeydown(e) {
      const visible = this.getVisibleOptions()
      if (!this.isOpen) {
        if (e.key === "ArrowDown" || e.key === "Enter" || e.key === " ") {
          e.preventDefault()
          this.openDropdown()
        }
        return
      }
      switch (e.key) {
        case "ArrowDown":
          e.preventDefault()
          this.highlighted = Math.min(this.highlighted + 1, visible.length - 1)
          this.applyHighlight(visible)
          break
        case "ArrowUp":
          e.preventDefault()
          this.highlighted = Math.max(this.highlighted - 1, 0)
          this.applyHighlight(visible)
          break
        case "Enter":
          e.preventDefault()
          if (this.highlighted >= 0 && visible[this.highlighted]) {
            this.selectOption(visible[this.highlighted])
          }
          break
        case "Escape":
          e.preventDefault()
          this.closeDropdown()
          break
        case "Tab":
          this.closeDropdown()
          break
      }
    },

    getVisibleOptions() {
      return this.allOptions.filter(li => !li.classList.contains("hidden"))
    },

    clearHighlight() {
      this.allOptions.forEach(li => li.classList.remove("bg-primary/10", "text-primary"))
    },

    applyHighlight(visible) {
      this.clearHighlight()
      const opt = visible[this.highlighted]
      if (opt) {
        opt.classList.add("bg-primary/10", "text-primary")
        opt.scrollIntoView({block: "nearest"})
      }
    },

    onDocumentClick(e) {
      if (!this.el.contains(e.target)) this.closeDropdown()
    }
  }
</script>
